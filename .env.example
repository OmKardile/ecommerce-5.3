# =============================================================================
# Patel Networks / MegaTechzy — environment template
#
# Usage:
#   sandbox/dev :  cp .env.example .env            (defaults are sim-safe)
#   VPS prod    :  cp .env.example .env  + follow deploy/ENV-SETUP.md
#
# Full per-variable runbook: deploy/ENV-SETUP.md
# Reference table:           docs/ENVIRONMENT.md
#
# RULES:
#   - NEVER commit the filled .env (git-ignored via `.env*`).
#   - Leave a variable UNSET rather than inventing a fake value: every
#     integration detects missing/`placeholder` credentials and switches to
#     its documented deterministic simulation — a wrong-looking real value
#     instead causes live API failures.
#   - `NEXT_PUBLIC_*` vars are inlined into client bundles at BUILD time;
#     all other vars are read at RUNTIME (no rebuild needed to rotate them,
#     except NEXT_PUBLIC_APP_URL on Docker builds — see compose comment).
# =============================================================================

# --------------------------------------------------------------- database ---
# Prisma connection. Provider is PostgreSQL in prisma/schema.prisma (Neon);
# the same var feeds sandbox dev, Render and Docker compose.
#
# production — Neon Postgres (Render: set this in the dashboard, not a file):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Docker compose VPS variant (host MUST be the compose service name `db`, not
# localhost; keep user/password/db in sync with the POSTGRES_* trio below):
# DATABASE_URL="postgresql://patel:CHANGE_ME@db:5432/patelnetworks?schema=public"
# sandbox fallback (SQLite — requires flipping provider in prisma/schema.prisma):
# DATABASE_URL="file:./db/custom.db"

# ------------------------------------------------------ sessions & secrets ---
# Signs HS256 session JWTs (pn_session, pn_admin_session) AND hashes OTP
# codes (sha256(code:JWT_SECRET)). Rotating it logs out everyone and voids
# outstanding OTPs. REQUIRED in production — the dev fallback strings
# ('patel_networks_dev_secret_change_in_production_32b!' for sessions,
# 'dev' for OTP hashes) must never reach a public host.
# Generate: openssl rand -hex 32
JWT_SECRET=

# --------------------------------------------------------------- web origin ---
# Public origin: metadataBase/canonicals, sitemap.xml, robots.txt.
# Also baked into the Docker image at build time (compose `args:`).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------ admin bootstrap ------
# On /admin/login, if no user matches ADMIN_EMAIL, a SUPER_ADMIN is
# bootstrapped with ADMIN_PASSWORD. ADMIN_PASSWORD also overrides the seed
# password when set while seeding.
# Generate a password: openssl rand -base64 18
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------ Razorpay (payments) ---
# Absent / containing 'placeholder' / rzp_test_placeholder* => simulated
# orders (order_sim_*), sandbox-only /api/payments/razorpay/simulate.
# Live keys from the Razorpay Dashboard → Settings → API Keys.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook HMAC secret — set the SAME value in Razorpay Dashboard → Webhooks.
# Generate: openssl rand -hex 16
# RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------- shipping (Shiprocket / Delhivery) ---
# Shiprocket creds missing or containing 'placeholder' => deterministic AWBs
# (DELH<10hex>), zone-based ETAs, printable label URLs. One provider's live
# credentials is enough for real shipping.
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# Optional API base override:
# SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
# Delhivery direct integration is keyed later; scans still sync the order FSM.
# DELHIVERY_API_KEY=
# Shared secret for the carrier tracking webhook (POST /api/webhooks/shipping).
# Configure the same value as a custom header x-webhook-token (or ?token=…) in
# the Shiprocket/Delhivery webhook settings. UNSET = sandbox posture: events
# are accepted but every one logs a set-this-before-go-live warning.
# SHIPPING_WEBHOOK_TOKEN=

# ------------------------------------------- SMS / WhatsApp (notifications) ---
# SMS (Fast2SMS-compatible, DLT): missing/placeholder/YOUR_* key => OTPs are
# printed as `[SIMULATED SMS] ... OTP: <code>` in server logs and API
# responses carry simulated:true. REQUIRED before real customer OTP logins.
# SMS_GATEWAY_API_KEY=
# SMS_SENDER_ID=PTLNET          (DLT sender id, 6 chars)
# SMS_TEMPLATE_ID=              (Fast2SMS DLT template id for the OTP message)

# WhatsApp Cloud API (Meta Graph v20): missing/placeholder => `[SIMULATED
# WHATSAPP]` log box + WHATSAPP_DISPATCH_SIMULATED audit row.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Webhook subscription verify token (Meta webhook GET challenge):
# WHATSAPP_VERIFY_TOKEN=

# --------------------------------------------------------- store overrides ---
# Rendered on GST invoices + footer via src/lib/constants.ts (ADR-014
# default shown). Replace with the client's real GSTIN in production.
# STORE_GSTIN=24AAACP1234F1Z8
# wa.me deep links (contact page, floating widget). Digits only, with 91
# prefix, no +:
# NEXT_PUBLIC_SUPPORT_WHATSAPP=919876543210

# =============================================================================
# Compose-only variables (consumed by docker-compose.yml / the containers —
# not read by Next.js code). Keep them in this same .env; compose loads it
# via env_file for both interpolation and the app/db services.
# =============================================================================

# postgres:16-alpine container credentials — must match DATABASE_URL above.
POSTGRES_USER=patel
POSTGRES_PASSWORD=
POSTGRES_DB=patelnetworks

# Container entrypoint: "true" runs `prisma migrate deploy` when
# prisma/migrations/ exists, else `prisma db push --skip-generate` (current
# repo strategy). Set to false only for one-off app-only containers.
RUN_MIGRATIONS=true

# Standalone Next server listen port inside the container (nginx proxies to
# app:3000; change only together with nginx/conf.d/patel.conf).
# PORT=3000
